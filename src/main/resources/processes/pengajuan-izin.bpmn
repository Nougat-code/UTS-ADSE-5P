<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_pengajuanIzin"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="pengajuanIzin" name="Pengajuan Izin Mahasiswa" isExecutable="true"
                camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_pengajuan">
      <bpmn:outgoing>Flow_start_validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_validasi" name="Validasi pengajuan"
                      camunda:class="com.utsrpl.projekuts.workflow.LeaveRequestDelegate">
      <bpmn:incoming>Flow_start_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_status" name="Status pengajuan"
                           default="Flow_rejected">
      <bpmn:incoming>Flow_validate_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_approved" name="Izin disetujui">
      <bpmn:incoming>Flow_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_approved_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_rejected" name="Izin ditolak">
      <bpmn:incoming>Flow_rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_rejected_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_approved">
      <bpmn:incoming>Flow_approved_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_rejected">
      <bpmn:incoming>Flow_rejected_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_validate" sourceRef="StartEvent_pengajuan" targetRef="Task_validasi"/>
    <bpmn:sequenceFlow id="Flow_validate_gateway" sourceRef="Task_validasi" targetRef="Gateway_status"/>
    <bpmn:sequenceFlow id="Flow_approved" name="APPROVED" sourceRef="Gateway_status" targetRef="Task_approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'APPROVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_rejected" name="REJECTED" sourceRef="Gateway_status" targetRef="Task_rejected"/>
    <bpmn:sequenceFlow id="Flow_approved_end" sourceRef="Task_approved" targetRef="End_approved"/>
    <bpmn:sequenceFlow id="Flow_rejected_end" sourceRef="Task_rejected" targetRef="End_rejected"/>
  </bpmn:process>
</bpmn:definitions>
